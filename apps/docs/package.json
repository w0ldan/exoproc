{
  "name": "docs",
  "version": "0.0.8",
  "private": true,
  "packageManager": "npm@12.0.1",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint",
    "build:workspace-deps": "cd ../.. && bun run build",
    "cf:build": "bun run build:workspace-deps && opennextjs-cloudflare build",
    "cf:preview": "bun run build:workspace-deps && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "bun run build:workspace-deps && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:upload": "bun run build:workspace-deps && opennextjs-cloudflare build && opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@monaco-editor/react": "^4.7.0",
    "win32-abi": "workspace:*",
    "win32-simulate": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.0.8",
    "fumadocs-core": "16.12.1",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.12.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "shadcn": "^4.14.1",
    "sonner": "^2.0.7",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.11",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  }
}
