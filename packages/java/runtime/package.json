{
  "name": "exoproc-runtime",
  "version": "0.7.0",
  "description": "Modular, identity-preserving hybrid/virtual/native Java runtime environment and class pool for the Exoproc / NJava ecosystem.",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/runner/index.d.ts",
      "import": "./dist/runner/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "exoproc",
    "njava",
    "runtime",
    "hybrid",
    "virtual",
    "reflection",
    "pool",
    "nashorn"
  ],
  "author": "Serkan",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "bun test"
  },
  "dependencies": {
    "exoproc-jjit": "workspace:*",
    "exoproc-mappings": "workspace:*",
    "exoproc-nashorn": "workspace:*",
    "exoproc-utils": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "homepage": "https://github.com/w0ldan/exoproc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w0ldan/exoproc.git",
    "directory": "packages/java/runtime"
  },
  "bugs": {
    "url": "https://github.com/w0ldan/exoproc/issues"
  }
}
