{
  "name": "exoproc-jjit",
  "version": "0.7.0",
  "description": "On-the-fly typed Java source synthesis, AST builder, ECJ compiler, and remapper for the Exoproc ecosystem.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    },
    "./remapper": {
      "types": "./dist/remapper.d.ts",
      "import": "./dist/remapper.js"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js"
    },
    "./modifiers": {
      "types": "./dist/modifiers.d.ts",
      "import": "./dist/modifiers.js"
    },
    "./jar": {
      "types": "./dist/jar.d.ts",
      "import": "./dist/jar.js"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "files": [
    "dist",
    "deps.json",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "exoproc",
    "jjit",
    "java",
    "compiler",
    "ecj",
    "remapper",
    "ast",
    "builder",
    "jar"
  ],
  "author": "Serkan",
  "scripts": {
    "build": "bun build ./src/index.ts ./src/compiler.ts ./src/remapper.ts ./src/builder.ts ./src/modifiers.ts ./src/jar.ts --outdir ./dist --target bun && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "bun test"
  },
  "dependencies": {
    "exoproc-mappings": "workspace:*",
    "exoproc-utils": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "homepage": "https://github.com/w0ldan/exoproc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w0ldan/exoproc.git",
    "directory": "packages/java/jjit"
  },
  "bugs": {
    "url": "https://github.com/w0ldan/exoproc/issues"
  }
}
