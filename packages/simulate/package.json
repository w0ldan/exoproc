{
  "name": "win32-simulate",
  "version": "0.7.1",
  "description": "Virtual Windows OS simulation engine and browser mock FFI layer for Exoproc.",
  "type": "module",
  "packageManager": "npm@12.0.1",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bun-ffi": {
      "types": "./dist/runtime/bun-ffi.d.ts",
      "import": "./dist/runtime/bun-ffi.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./files": {
      "types": "./dist/platform/files/index.d.ts",
      "import": "./dist/platform/files/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node scripts/node-launcher.mjs scripts/cli-main.ts",
    "run": "node scripts/node-launcher.mjs scripts/run-cmd.ts",
    "exec": "node scripts/node-launcher.mjs scripts/run-cmd.ts",
    "inspect": "node --import tsx scripts/inspect-artifacts.ts",
    "inspect:nasm": "node --import tsx scripts/verify-nasm.ts",
    "build": "tsc",
    "test": "tsx ../../scripts/build-tests.ts simulate && node scripts/node-launcher.mjs --test ../../tests/dist/simulate/*.node.test.mjs",
    "test:node": "tsx ../../scripts/build-tests.ts simulate && node scripts/node-launcher.mjs --test ../../tests/dist/simulate/*.node.test.mjs"
  },
  "keywords": [
    "exoproc",
    "simulation",
    "os",
    "virtual-machine",
    "debugger",
    "win64",
    "ffi"
  ],
  "author": "Serkan",
  "license": "MIT",
  "dependencies": {
    "win32-abi": "^0.7.1",
    "bun-capstone-abi": "^0.7.1",
    "exoproc-asm": "^0.7.1",
    "expect": "^30.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  },
  "homepage": "https://github.com/w0ldan/exoproc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w0ldan/exoproc.git",
    "directory": "packages/simulate"
  },
  "bugs": {
    "url": "https://github.com/w0ldan/exoproc/issues"
  }
}
