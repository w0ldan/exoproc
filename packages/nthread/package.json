{
  "name": "bun-nthread",
  "version": "0.7.1",
  "description": "Non-invasive x64 Windows thread redirection library for Bun — delegate execution to existing threads without machineCode, remote allocation, or CreateRemoteThread.",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "exoproc",
    "thread-redirection",
    "windows",
    "x64",
    "native",
    "context-redirection",
    "rop-stub",
    "memset",
    "msvcrt"
  ],
  "author": "Serkan",
  "homepage": "https://github.com/w0ldan/exoproc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w0ldan/exoproc.git",
    "directory": "packages/nthread"
  },
  "bugs": {
    "url": "https://github.com/w0ldan/exoproc/issues"
  },
  "dependencies": {
    "bun-winapi": "^0.7.1",
    "bun-xffi": "^0.7.1",
    "exoproc-utils": "^0.7.1"
  }
}
