{
  "name": "bun-xffi",
  "version": "0.6.6",
  "description": "Win32-optimized Cross-Process FFI foundation for Bun.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cdefine": {
      "types": "./dist/cdefine.d.ts",
      "import": "./dist/cdefine.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "types": "./dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "exoproc",
    "ffi",
    "win32",
    "windows",
    "x64",
    "cross-process",
    "memory",
    "systems-instrumentation"
  ],
  "author": "Serkan",
  "homepage": "https://github.com/w0ldan/exoproc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w0ldan/exoproc.git",
    "directory": "packages/xffi"
  },
  "bugs": {
    "url": "https://github.com/w0ldan/exoproc/issues"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "exoproc-utils": "workspace:*",
    "win32-abi": "workspace:*"
  }
}
