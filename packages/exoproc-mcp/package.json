{
  "name": "exoproc-mcp",
  "version": "0.7.1",
  "description": "Dedicated Model Context Protocol (MCP) server for native Windows x64 reverse engineering, thread hijacking, function hooking, memory inspection, and JVM analysis.",
  "main": "./dist/index.js",
  "bin": {
    "exoproc-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "types": "./dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "files": [
    "dist",
    "!dist/*.exe",
    "!dist/exoproc-mcp",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "exoproc",
    "mcp",
    "reverse-engineering",
    "hooking",
    "thread-hijacking",
    "memory",
    "instrumentation",
    "agent"
  ],
  "author": "Serkan",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.24.1",
    "bun-winapi": "^0.7.1",
    "bun-xffi": "^0.7.1",
    "bun-minhook": "^0.7.1",
    "bun-nthread": "^0.7.1",
    "bun-njava": "^0.7.1",
    "bun-capstone": "^0.7.1",
    "exoproc-accessors": "^0.7.1",
    "exoproc-ipc": "^0.7.1",
    "exoproc-utils": "^0.7.1"
  },
  "homepage": "https://github.com/w0ldan/exoproc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w0ldan/exoproc.git",
    "directory": "packages/exoproc-mcp"
  },
  "bugs": {
    "url": "https://github.com/w0ldan/exoproc/issues"
  },
  "mcpName": "io.github.w0ldan/exoproc"
}
