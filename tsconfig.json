      "bun-winapi": ["./packages/win32/api/src/index.ts"],
      "bun-nthread": ["./packages/nthread/src/index.ts"],
      "bun-minhook": ["./packages/minhook/src/index.ts"],
      "bun-nshm": ["./packages/nshm/src/index.ts"],
      "bun-njava": ["./packages/java/njava/src/index.ts"],
      "bun-njava/reflection-parser": [
        "./packages/java/njava/src/reflection-parser.ts"
      ],
      "@exoproc/win32-abi": ["./packages/win32/abi/src/index.ts"],
      "win32-abi": ["./packages/win32/abi/src/index.ts"],
      "@exoproc/simulate": ["./packages/simulate/src/index.ts"],
      "simulate": ["./packages/simulate/src/index.ts"],
